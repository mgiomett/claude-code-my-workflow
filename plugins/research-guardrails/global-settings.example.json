{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.*.local)",
      "Edit(//**/.env.production)",
      "Read(//**/.Renviron)",
      "Edit(//**/.Renviron)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/id_ecdsa*)",
      "Read(//**/*.pem)",
      "Read(//**/credentials.json)",
      "Read(//**/service-account*.json)",
      "Edit(~/.claude/projects/**/*.jsonl)",
      "Edit(//System/**)",
      "Edit(//usr/**)",
      "Edit(//bin/**)",
      "Edit(//sbin/**)",
      "Edit(//etc/**)",
      "Edit(//private/etc/**)",
      "Edit(//Library/**)",
      "Edit(//Applications/**)",
      "Edit(~/Library/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(security *)",
      "Bash(dd *)",
      "Bash(diskutil *)",
      "Bash(mkfs*)",
      "Bash(fdisk *)",
      "Bash(newfs*)",
      "Bash(launchctl *)",
      "Bash(systemsetup *)",
      "Bash(scutil *)",
      "Bash(csrutil *)",
      "Bash(spctl *)",
      "Bash(nvram *)",
      "Bash(kextload *)",
      "Bash(kextunload *)",
      "Bash(defaults write *)",
      "Bash(chown *)",
      "Bash(shutdown *)",
      "Bash(reboot *)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git branch -D *)",
      "Bash(git push --force-with-lease *)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(rm -R*)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh release *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)"
    ],
    "allow": [
      "Bash",
      "Read(**)",
      "Edit(**)",
      "WebSearch",
      "WebFetch"
    ]
  }
}
